# Copy this file to .env.docker, change all passwords, then run:
# docker compose --env-file .env.docker up -d --build
APP_PORT=3000
DOCKER_DB_PASSWORD=replace_with_a_strong_database_password
DOCKER_DB_ROOT_PASSWORD=replace_with_a_different_root_password
SYSTEM_ADMIN_PASSWORD=replace_with_a_strong_admin_password

# Optional email settings for password-reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
