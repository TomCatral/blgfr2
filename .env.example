PORT=3000
NODE_ENV=development
# Optional frontend API root. Leave empty for same-origin deployments.
VITE_API_BASE=

# Local MySQL 8.0 database.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=blgf_region2_doctrack
MYSQL_SSL=false

# The application uses a single MySQL database.

# SMTP settings used by the administrator-only forgot-password flow.
# For Gmail, use smtp.gmail.com, port 465, SMTP_SECURE=true, and an app password.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=BLGF Document Tracking System <notifications@example.com>

# Used only if the reserved Tom Catral System Administrator is missing from
# the database. Configure this secret in Vercel; never commit the real value.
SYSTEM_ADMIN_PASSWORD=choose_a_strong_private_password
