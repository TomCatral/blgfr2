{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate --schema prisma/mysql/schema.prisma",
    "prisma:generate": "prisma generate --schema prisma/mysql/schema.prisma",
    "dev": "tsx backend/server.ts",
    "build:frontend": "vite build --config frontend/vite.config.ts",
    "build:backend": "esbuild backend/server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/backend/server.cjs",
    "build:api": "esbuild backend/vercel-handler.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.js",
    "build": "npm run build:frontend && npm run build:backend && npm run build:api",
    "start": "node dist/backend/server.cjs",
    "preview": "vite preview --config frontend/vite.config.ts",
    "clean": "node scripts/clean.mjs",
    "lint:frontend": "tsc --noEmit -p frontend/tsconfig.json",
    "lint:backend": "tsc --noEmit -p backend/tsconfig.json",
    "lint": "npm run lint:frontend && npm run lint:backend"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.4.0",
    "@prisma/client": "^6.19.0",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.25.0",
    "prisma": "^6.19.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
