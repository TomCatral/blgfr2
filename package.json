{
  "name": "blgf-document-tracking-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate --schema prisma/mysql/schema.prisma",
    "prisma:generate": "prisma generate --schema prisma/mysql/schema.prisma",

    "predev": "node scripts/free_ports.cjs",
    "dev": "npm run build:frontend:dev && concurrently --names server,frontend \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "tsx watch backend/server.ts",
    "dev:frontend": "npm run watch --prefix frontend",

    "build:frontend:dev": "npm run build --prefix frontend -- --configuration development",
    "build:frontend": "npm run build --prefix frontend",

    "build:backend": "esbuild backend/server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/backend/server.cjs",

    "build:api": "esbuild backend/vercel-handler.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.js",

    "build": "npm run build:frontend && npm run build:backend && npm run build:api",

    "start": "node dist/backend/server.cjs",

    "preview": "npm run start --prefix frontend",

    "clean": "node scripts/clean.mjs",

    "lint:frontend": "cd frontend && npm run lint",
    "lint:backend": "tsc --noEmit -p backend/tsconfig.json",
    "lint": "npm run lint:frontend && npm run lint:backend"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.0",
    "prisma": "^6.19.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
